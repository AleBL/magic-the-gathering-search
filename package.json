{
  "name": "magic-the-gathering-deckforge",
  "version": "0.9.6",
  "license": "MIT",
  "main": "dist-electron/index.js",
  "author": {
    "name": "Alessandro Barros"
  },
  "description": "Magic: The Gathering card search, deck builder, active analytics, and playtest simulator.",
  "keywords": [
    "vite",
    "react",
    "electron",
    "typescript",
    "mtg",
    "deckforge"
  ],
  "repository": {
    "url": "https://github.com/AleBL/magic-the-gathering-deckforge"
  },
  "productName": "MTG Deck Forge",
  "packageManager": "yarn@4.17.1",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --config vite.config.web.mts",
    "build": "yarn build:vite && yarn build:electron",
    "build:vite": "yarn clean && vite build",
    "build:web": "yarn clean && vite build --config vite.config.web.mts",
    "build:electron": "tsc -p electron",
    "dist": "yarn clean && yarn build && electron-builder --publish never",
    "build:win": "yarn clean && yarn build && electron-builder --win --publish never",
    "build:mac": "yarn clean && yarn build && electron-builder --mac --publish never",
    "build:linux": "yarn clean && yarn build && electron-builder --linux --publish never",
    "pack:app": "yarn clean && yarn build && electron-builder --dir",
    "clean": "rimraf dist dist-electron dist-vite",
    "type-check": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --fix",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint .",
    "i18n:check": "node scripts/i18n-check.mjs --ci",
    "readme:check": "node scripts/readme-check.mjs --ci",
    "deps:update": "taze major -I",
    "test:e2e": "playwright test",
    "test:e2e:electron": "ELECTRON_E2E=1 playwright test",
    "test:e2e:bench": "BENCH=1 playwright test --workers=1 --reporter=list bench",
    "test:e2e:ui": "playwright test --ui",
    "deadcode": "knip",
    "seed:profile": "node scripts/seed-profile.mjs",
    "collection:csv": "node scripts/generate-collection-csv.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.10",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "i18next": "^26.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1",
    "scryfall-sdk": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "taze": "^21.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "taze": {
    "packageMode": {
      "typescript": "minor",
      "eslint": "minor",
      "@eslint/js": "minor"
    }
  },
  "build": {
    "appId": "com.alessandro.mtgdeckforge",
    "productName": "MTG Deck Forge",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "dist-electron",
      "dist-vite"
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MTG Deck Forge",
      "license": "LICENSE.md",
      "runAfterFinish": true
    },
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.entertainment",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "icon": "resources/icon.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Game",
      "maintainer": "Alessandro Barros",
      "target": [
        "AppImage",
        "deb",
        "zip"
      ]
    }
  }
}
